NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_64_char_random_hex_string
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
SEED_ADMIN_PASSWORD=dev_admin_password
SEED_MANAGER_PASSWORD=dev_manager_password
SEED_FRONT_DESK_PASSWORD=dev_front_desk_password
SEED_HOUSEKEEPING_PASSWORD=dev_housekeeping_password
